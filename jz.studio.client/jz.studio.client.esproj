<Project Sdk="Microsoft.VisualStudio.JavaScript.Sdk/0.5.128-alpha">
  <PropertyGroup>
    <StartupCommand>npm start</StartupCommand>
    <JavaScriptTestFramework>Jasmine</JavaScriptTestFramework>
    <!-- Allows the build (or compile) script located on package.json to run on Build -->
    <ShouldRunBuildScript>false</ShouldRunBuildScript>
    <!-- Folder where production build objects will be placed -->
    <PublishAssetsDirectory>$(MSBuildProjectDirectory)\dist\jz.studio.client\</PublishAssetsDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="src\assets\css\" />
    <Folder Include="src\_components\charts\technical-analysis\engine\indicators\" />
    <Folder Include="src\_components\charts\technical-analysis\engine\rendering\" />
    <Folder Include="src\_components\jz-charts\" />
    <Folder Include="src\_components\overlays\" />
    <Folder Include="src\library\jz-docking\dock-spawn\classes\" />
    <Folder Include="src\library\jz-menu\" />
    <Folder Include="src\library\jz-sine-plot\" />
    <Folder Include="src\models\" />
    <Folder Include="src\_components\popovers\" />
    <Folder Include="src\_framework\ui\popover\jz-popover-error\" />
    <Folder Include="src\_framework\ui\popover\jz-popover-loading\" />
    <Folder Include="src\_framework\layout\panel-workspace\enums\" />
  </ItemGroup>
  <ItemGroup>
    <None Include=".backup\jz-spirograph\jz-spirograph.component.css" />
    <None Include=".backup\jz-spirograph\jz-spirograph.component.html" />
    <None Include=".backup\jz-spirograph\jz-spirograph.component.spec.ts" />
    <None Include=".backup\jz-spirograph\jz-spirograph.component.ts" />
    <None Include=".backup\jz-spirograph\jz-spirograph.module.ts" />
    <None Include=".backup\jz-spirograph\jz-spirograph.service.spec.ts" />
    <None Include=".backup\jz-spirograph\jz-spirograph.service.ts" />
    <None Include=".backup\jz-spirograph\spiro.spec.ts" />
    <None Include=".backup\jz-spirograph\spiro.ts" />
    <None Include=".backup\utilities\keyed-collection.spec.ts" />
    <None Include=".backup\utilities\keyed-collection.ts" />
    <None Include=".backup\utilities\utilities.module.ts" />
  </ItemGroup>
  <ItemGroup>
    <TypeScriptConfiguration Remove=".backup\jz-spirograph\**" />
  </ItemGroup>
  <ItemGroup>
    <None Remove=".backup\jz-spirograph\**" />
  </ItemGroup>
</Project>